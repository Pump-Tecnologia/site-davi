# Credenciais de acesso ao painel Studio Elite (LP + dashboard pós-compra).
# Defina estes valores no provedor (ex.: Vercel > Settings > Environment Variables)
# e, localmente, em um arquivo .env.local (que NÃO é versionado).
PANEL_AUTH_EMAIL=admin@studioelite.com
PANEL_AUTH_PASSWORD=troque-por-uma-senha-forte

# Segredo usado para assinar o cookie de sessão (HMAC). Gere um valor aleatório, ex.:
#   openssl rand -hex 32
# Trocar este valor invalida todas as sessões ativas.
AUTH_SECRET=gere-um-valor-aleatorio-longo
